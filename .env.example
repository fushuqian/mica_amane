# ===== 必填 =====
# metacubexd agent 控制口令（会注入浏览器，仅同源控制用，不是访问控制）
CONTROL_TOKEN=change-me-control
# mihomo Clash API 密钥
CLASH_SECRET=change-me-clash
# 配置页 Basic Auth
CONSOLE_USER=admin
CONSOLE_PASSWORD=change-me-console

# ===== amane =====
# 留空则由 amane 自动生成并写入 /data/amane/token，配置页可读取
AMANE_TOKEN=
# amane 允许访问的媒体目录；多个用逗号分隔
AMANE_SAFE_DIRS=/media

# ===== 映射 =====
# 端口绑定地址；公网反代模式请改成 127.0.0.1
BIND_ADDR=0.0.0.0
# 宿主机媒体目录
MEDIA_DIR=./media
TZ=Asia/Shanghai

# ===== 可选：公网 HTTPS（docker compose --profile public up -d）=====
# BASE_DOMAIN=example.com
# PANEL_USER=admin
# PANEL_PASSWORD_HASH=$2a$14$xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx   # caddy hash-password 生成
# DEFAULT_BACKEND_URL=https://dex.example.com/clash
