# ===== 必填 =====
# mihomo Clash API 密钥（配置页与内核共用）
CLASH_SECRET=change-me-clash

# ===== 配置页登录 =====
# 留空则首次打开配置页进入免密向导，由向导设置用户名与密码。
# 已设置过向导密码后，以 /data/mihomo/credentials.json 为准。
CONSOLE_USER=admin
CONSOLE_PASSWORD=

# ===== amane =====
# 留空则由 amane 自动生成并写入 /data/amane/token，配置页可读取
AMANE_TOKEN=
# amane 允许访问的媒体目录；多个用逗号分隔
AMANE_SAFE_DIRS=/media

# 订阅下载使用的 User-Agent（部分机场按 UA 放行/拦截）
SUB_USER_AGENT=mihomo.party/v2.0.4 (clash.meta)

# ===== 映射 =====
# 端口绑定地址；公网反代模式请改成 127.0.0.1
BIND_ADDR=0.0.0.0
# 宿主机媒体目录
MEDIA_DIR=./media
TZ=Asia/Shanghai

# ===== 可选：公网 HTTPS（docker compose --profile public up -d）=====
# BASE_DOMAIN=example.com
# PANEL_USER=admin
# PANEL_PASSWORD_HASH=$2a$14$xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx   # caddy hash-password 生成
# 配置页上的 amane 跳转链接（公网模式必须填）
# PUBLIC_AMANE_URL=https://amane.example.com
